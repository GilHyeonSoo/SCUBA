# Mapbox public access token (starts with pk.)
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-public-token

# Map API master switch (default off — blocks Mapbox tile/network calls)
EXPO_PUBLIC_MAP_API_ENABLED=false

# Supabase (required for Channel3 gear catalog via Edge Function)
# Use project root URL only — do NOT append /rest/v1/
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
