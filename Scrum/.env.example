# Google Places API (New)
# https://console.cloud.google.com/google/maps-apis/
GOOGLE_PLACES_API_KEY=

# Map / place API master switch (default: ALL blocked)
MAP_API_ENABLED=false

# Billing guardrails (default: blocked)
# Never enable these casually. One full enrichment run on ~1,100 places can cost ₩30,000–₩100,000+.
GOOGLE_PLACES_API_ENABLED=false
GOOGLE_PLACES_DRY_RUN=false
GOOGLE_PLACES_CONFIRM=
GOOGLE_PLACES_MAX_PLACES=25
GOOGLE_PLACES_MAX_PHOTOS_PER_PLACE=0
GOOGLE_PLACES_MAX_BILLABLE_CALLS=100
GOOGLE_PLACES_SKIP_EXISTING_BATCHES=true
NAVER_LOCAL_API_ENABLED=false
KAKAO_LOCAL_API_ENABLED=false

# Naver Developers - Local Search API
# https://developers.naver.com/docs/serviceapi/search/local/local.md
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Kakao Developers - Local REST API
# https://developers.kakao.com/docs/latest/ko/local/dev-guide
KAKAO_REST_API_KEY=

# Overpass API does not require a key.

# Supabase import (Dashboard → Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dive log PoC import target user (Supabase Auth → Users → User UID)
POC_USER_ID=
