# Google Places API (New)
# https://console.cloud.google.com/google/maps-apis/
GOOGLE_PLACES_API_KEY=

# Naver Developers - Local Search API
# https://developers.naver.com/docs/serviceapi/search/local/local.md
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Kakao Developers - Local REST API
# https://developers.kakao.com/docs/latest/ko/local/dev-guide
KAKAO_REST_API_KEY=

# Overpass API does not require a key.

# Supabase import (Dashboard → Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
